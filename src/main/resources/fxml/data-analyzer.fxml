<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Scene?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<!-- Author: Bryan Yerina-->

<Scene xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx"
       fx:controller="controllers.DataAnalyzerController"
       width="800" height="600">
    <!-- Set up GridPane with padding on the sides -->
    <GridPane alignment="CENTER" hgap="15" vgap="15">
        <!-- Insert padding -->
        <padding>
            <Insets topRightBottomLeft="15"/>
        </padding>
        <!-- Define different font sizes -->
        <fx:define>
            <Font fx:id="mediumFont" size="20"/>
            <Font fx:id="largeFont" size="32"/>
        </fx:define>

        <!-- Select file button -->
        <!-- TODO: Add onAction tag when glue code gets select file function -->
        <Button text="Select file" font="$largeFont" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.halignment="CENTER"/>

        <!-- Stats text box -->
        <Label fx:id="statsArea" text="Stats" font="$mediumFont" prefHeight="300" prefWidth="600" GridPane.rowIndex="2" GridPane.columnIndex="0" alignment="CENTER" GridPane.halignment="CENTER"
               style="-fx-border-color: gray;
              -fx-border-width: 1;
              -fx-padding: 10;
              -fx-background-color: white;" />

        <!-- Export to .txt button -->
        <!-- TODO: Add onAction tag when glue code gets export file function -->
        <Button text="Export stats to .txt" font="$largeFont" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.halignment="CENTER"/>

        <!-- Help button -->
        <!-- TODO: Add onAction tag when glue code gets open help button (if we decide to add that) -->
        <Button text="Help" font="$largeFont" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.halignment="CENTER"/>

    </GridPane>
</Scene>
